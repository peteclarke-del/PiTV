# Copy to docker/.env and fill in for this machine. docker/.env is not committed.
# Paths are the host's; the containers see them at the same place (docker-compose.yml).
PITV_SRC=/path/to/PiTV
CONTENT_SRC=/path/to/PiTV_content
# the drive holding the cache; PiTV's cache_dir is <this>/pitv
CACHE_DIR=/path/to/cache
# the host's time zone, as in /etc/timezone
TZ=Europe/London
HOST_UID=1000
HOST_GID=1000
# getent group video
VIDEO_GID=44
# getent group render
RENDER_GID=110
# the desktop's display, for the windowed player
WAYLAND_DISPLAY=wayland-0

# The library shares: where each is mounted (its source root in pitv_content) and what it is.
NAS_OPTIONS=guest,ro,vers=3.0,uid=1000,gid=1000,iocharset=utf8
NAS_TVSHOWS_DEVICE=//nas/TVShows
NAS_TVSHOWS_TARGET=/mnt/nas/tvshows
NAS_TVSPORTS_DEVICE=//nas/TVSports
NAS_TVSPORTS_TARGET=/mnt/nas/tvsports
NAS_MOVIES_DEVICE=//nas/Movies
NAS_MOVIES_TARGET=/mnt/nas/movies
NAS_ADS_DEVICE=//nas/Ads
NAS_ADS_TARGET=/mnt/nas/ads
NAS_MUSICVIDEOS_DEVICE=//nas/Music Videos
NAS_MUSICVIDEOS_TARGET=/mnt/nas/music-videos
