# DietPi first-boot automation for PiTV. Filled in by the installer from pitv-install.json;
# only the keys PiTV cares about are listed, everything else stays at DietPi's defaults.
# No SSH key is given here: DietPi would install it for root and the dietpi user, and the
# first-boot script grants SSH to the maintenance user only.
AUTO_SETUP_ACCEPT_LICENSE=1
AUTO_SETUP_LOCALE=@LOCALE@
AUTO_SETUP_KEYBOARD_LAYOUT=@KEYBOARD@
AUTO_SETUP_TIMEZONE=@TIMEZONE@
AUTO_SETUP_NET_ETHERNET_ENABLED=@ETHERNET@
AUTO_SETUP_NET_WIFI_ENABLED=@WIFI@
AUTO_SETUP_NET_WIFI_COUNTRY_CODE=@WIFI_COUNTRY@
AUTO_SETUP_NET_HOSTNAME=@HOSTNAME@
AUTO_SETUP_NET_USESTATIC=@USESTATIC@
AUTO_SETUP_NET_STATIC_IP=@STATIC_IP@
AUTO_SETUP_NET_STATIC_GATEWAY=@GATEWAY@
AUTO_SETUP_NET_STATIC_DNS=@DNS@
AUTO_SETUP_HEADLESS=1
AUTO_SETUP_AUTOMATED=1
AUTO_SETUP_GLOBAL_PASSWORD=@GLOBAL_PASSWORD@
AUTO_SETUP_SSH_SERVER_INDEX=-2
AUTO_SETUP_LOGGING_INDEX=0
AUTO_SETUP_RAMLOG_MAXSIZE=50
AUTO_SETUP_CUSTOM_SCRIPT_EXEC=1
AUTO_SETUP_INSTALL_SOFTWARE_ID=
SURVEY_OPTED_IN=0
CONFIG_SERIAL_CONSOLE_ENABLE=0
CONFIG_NTP_MODE=4
CONFIG_CHECK_DIETPI_UPDATES=0
CONFIG_CHECK_APT_UPDATES=0
CONFIG_BOOT_WAIT_FOR_NETWORK=1
