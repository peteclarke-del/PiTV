[Unit]
Description=PiTV player (mpv on DRM, schedule follower)
# Do not Require the mounts: playback starts with the test card and retries until the NAS is up.
After=network-online.target remote-fs.target systemd-timesyncd.service time-sync.target
Wants=network-online.target systemd-timesyncd.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90
User=pitv
Group=pitv
SupplementaryGroups=video render audio input tty
Environment=PITV_DATA=/var/lib/pitv
Environment=PITV_RUN=/run/pitv
RuntimeDirectory=pitv
RuntimeDirectoryPreserve=yes
ExecStart=/opt/pitv/.venv/bin/pitv play
Restart=always
RestartSec=2
StartLimitIntervalSec=0
TimeoutStopSec=10
# Memory: a leak gets killed and restarted rather than taking the Pi down.
MemoryHigh=900M
MemoryMax=1200M
OOMPolicy=kill
# Give mpv real-time-ish priority so audio never stutters under a scan or copy.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2
# The player needs the DRM, input and ALSA devices, the data dir, /run/pitv and the cache drive;
# nothing under /usr, /etc or /boot is ever written.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pitv-player

[Install]
WantedBy=multi-user.target
