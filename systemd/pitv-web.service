[Unit]
Description=PiTV web interface
After=network-online.target pitv-player.service
Wants=network-online.target
# The database. On an installer-made card it is a bind mount from /work; elsewhere this is a no-op.
RequiresMountsFor=/var/lib/pitv
# No start limit: the admin is how the Pi is repaired, so it keeps retrying. RestartSec paces it.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=pitv
Group=pitv
Environment=PITV_DATA=/var/lib/pitv
Environment=PITV_RUN=/run/pitv
Environment=PITV_WEB_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/opt/pitv/.venv/bin/pitv web
Restart=always
RestartSec=3
TimeoutStopSec=10
MemoryHigh=400M
MemoryMax=600M
OOMPolicy=kill
Nice=5
# Sandbox. The admin's service actions run `sudo -n systemctl ...` (/etc/sudoers.d/pitv), and
# sudo needs its setuid bit. So no NoNewPrivileges=, and none of the settings that imply it for
# a service running as a user on systemd 252 (Debian 12): ProtectKernelTunables=,
# ProtectKernelModules=, ProtectKernelLogs=, ProtectClock=, ProtectHostname=, PrivateDevices=,
# RestrictSUIDSGID=, RestrictNamespaces=, RestrictRealtime=, RestrictAddressFamilies=,
# LockPersonality=, MemoryDenyWriteExecute=, SystemCallFilter= and SystemCallArchitectures=.
# What remains are the mount namespace protections. ProtectSystem=full rather than strict, as
# for the player: the cache directory can change at runtime.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectControlGroups=yes
SyslogIdentifier=pitv-web

[Install]
WantedBy=multi-user.target
