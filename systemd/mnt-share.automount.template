# Generated by setup/install.sh from systemd/mnt-share.automount.template, one per NAS share.
# The share is mounted on first access, so a NAS that is down at boot delays nothing.
[Unit]
Description=PiTV media share @SHARE@ (automount)

[Automount]
Where=@WHERE@
TimeoutIdleSec=0

[Install]
WantedBy=multi-user.target
