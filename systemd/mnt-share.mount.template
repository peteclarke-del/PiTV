# Generated by setup/install.sh from systemd/mnt-share.mount.template, one per NAS share, and
# rewritten on every install. The share is mounted read-only: PiTV and pitv_content never write
# to the NAS. The credentials file is root-only; mount.cifs reads it as root.
[Unit]
Description=PiTV media share @SHARE@
After=network-online.target
Wants=network-online.target

[Mount]
What=//@NAS@/@SHARE@
Where=@WHERE@
Type=cifs
Options=credentials=/etc/pitv/smb-credentials,vers=3.0,ro,noserverino,cache=loose,actimeo=60,uid=pitv,gid=pitv,iocharset=utf8,_netdev
TimeoutSec=30
