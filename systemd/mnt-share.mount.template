# Template: one copy per share, generated by setup/install.sh
[Unit]
Description=PiTV media share @SHARE@
After=network-online.target
Wants=network-online.target

[Mount]
What=//@NAS@/@SHARE@
Where=/mnt/@SHARE@
Type=cifs
Options=credentials=/etc/pitv/smb-credentials,vers=3.0,ro,noserverino,cache=loose,actimeo=60,uid=pitv,gid=pitv,iocharset=utf8,_netdev,x-systemd.automount,x-systemd.idle-timeout=0,x-systemd.mount-timeout=30
TimeoutSec=30
